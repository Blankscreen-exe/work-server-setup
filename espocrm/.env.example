# EspoCRM - crm.graylining.com
ESPOCRM_DOMAIN=crm.graylining.com

# Initial admin account (change the password after first login)
# WARNING: EspoCRM 10.0.7's docker entrypoint hardcodes "set-password admin",
# so a from-scratch install ONLY completes if this value is exactly "admin".
# Any other value aborts the installer silently (set -e) and the container
# restart-loops. The live admin account on this instance is "hammad".
ESPOCRM_ADMIN_USERNAME=admin
ESPOCRM_ADMIN_PASSWORD=

# Database (generated - you never need these day to day)
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=espocrm
MYSQL_USER=espocrm
MYSQL_PASSWORD=

# Outgoing email via Stalwart.
# SMTP_PASSWORD is intentionally blank - put the contact@graylining.com
# mailbox password here, then: docker compose up -d
SMTP_SERVER=mail.graylining.com
SMTP_PORT=587
SMTP_USERNAME=contact@graylining.com
SMTP_PASSWORD=
OUTBOUND_FROM_NAME=Graylining CRM
