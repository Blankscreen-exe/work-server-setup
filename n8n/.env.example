# N8N Configuration
GENERIC_TIMEZONE=UTC

# Hostname n8n is served on
N8N_HOST=n8n-internal.example.com

# Referenced by the Traefik labels in docker-compose.yml.
# Easy to miss: if unset, the router rule resolves to an empty host and
# n8n is never routed.
N8N_DOMAIN=n8n-internal.example.com

# n8n serves at the root of its own subdomain - no path prefix.
WEBHOOK_URL=https://n8n-internal.example.com/

# --- Outgoing email (enables invites and "forgot password") ---------------
# Without these, n8n reports "n8n isn't set up to send email right now" and the
# only account recovery is `n8n user-management:reset` from the CLI.
# Port 465 with implicit TLS is n8n's own default.
N8N_EMAIL_MODE=smtp
N8N_SMTP_HOST=mail.example.com
N8N_SMTP_PORT=465
N8N_SMTP_SSL=true
N8N_SMTP_USER=system@example.com
N8N_SMTP_PASS=
N8N_SMTP_SENDER=n8n <system@example.com>
