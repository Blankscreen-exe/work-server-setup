STORAGE_DOMAIN=koecast-storage.graylining.com
MINIO_ROOT_USER=minio-admin
MINIO_ROOT_PASSWORD=
# Origins browsers may upload from (comma-separated). Default would be "*".
CORS_ALLOW_ORIGIN=https://koecast.graylining.com
# KoeCast's own least-privilege user, created at init - never the root login.
KOECAST_S3_ACCESS_KEY=koecast-app
KOECAST_S3_SECRET_KEY=
